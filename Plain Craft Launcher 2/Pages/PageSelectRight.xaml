<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSelectRight"
    PanScroll="PanBack">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:MyCard Margin="25,25,25,0" UseAnimation="False" HasMouseAnimation="False">
            <Grid Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Minecraft 目录" FontSize="20" Foreground="{DynamicResource ColorBrush1}" />
                <TextBlock x:Name="LabFolderPath" Grid.Row="1" Margin="0,9,0,13" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ColorBrush1}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="下方是此目录中的版本；点击版本可打开文件夹。" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.65" Margin="0,0,18,0" />
                    <local:MyButton Grid.Column="1" x:Name="BtnFolderDownload" Text="在此目录下载新版本" ColorType="Highlight" Height="36" Padding="18,0" />
                </Grid>
            </Grid>
        </local:MyCard>
        <Grid x:Name="PanAllBack" Grid.Row="1">
            <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
                <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True" />
            </local:MyScrollViewer>
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty" UseAnimation="False">
                <StackPanel Margin="20,17">
                    <TextBlock Name="LabEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" Text="此目录暂无游戏版本" FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock Name="LabEmptyContent" Margin="10,15,10,5" Text="确认上方目录后，即可下载第一个版本。&#xa;已有游戏？在左侧添加对应的 .minecraft 根目录。" TextWrapping="Wrap" />
                    <local:MyButton Height="35" HorizontalAlignment="Center" x:Name="BtnEmptyDownload" MinWidth="140" Text="在此目录下载新版本" Margin="0,10,0,0" Padding="13,0" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>
        </Grid>
        <local:MyCard Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" x:Name="PanLoad" Margin="40">
            <local:MyLoading Text="正在获取版本列表" Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutoRun="False" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
